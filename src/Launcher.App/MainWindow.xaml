<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="業務ランチャー"
        Width="960"
        Height="600"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <!-- ステップ1では起動確認用のサンプルを表示し、設定連携と MVVM 化は後続ステップで行います。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#172033" Text="業務ランチャー" />
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#667085" Text="利用するカテゴリーを選択してください" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="16" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Margin="8,0,8,12" FontSize="13" FontWeight="SemiBold" Foreground="#667085" Text="カテゴリー" />
                    <Button Height="48" Padding="14,0" HorizontalContentAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Content="日常業務" />
                    <Button Height="48" Margin="0,8,0,0" Padding="14,0" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="#D0D5DD" Content="管理ツール" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="24" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#172033" Text="日常業務" />
                    <WrapPanel Margin="0,20,0,0">
                        <Button Width="176" Height="112" Margin="0,0,16,16" Background="#F8FAFC" BorderBrush="#D0D5DD">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontSize="30" Text="▣" />
                                <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" Text="電卓" />
                            </StackPanel>
                        </Button>
                        <Button Width="176" Height="112" Margin="0,0,16,16" Background="#F8FAFC" BorderBrush="#D0D5DD">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontSize="30" Text="▤" />
                                <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" Text="メモ帳" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
